# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw*

# Local environment variables and secrets
.env
.env.*
!.env.example

# Compiled binaries/executables (e.g., from 'go build')
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries generated by 'go test -c'
*.test

# Output from profiling and benchmarks (e.g., 'go test -cpuprofile')
*.prof
*.out
*.coverprofile
profile.cov
coverage.txt

# Go workspace files
go.work
go.work.sum

# Miscellaneous
.DS_Store
Thumbs.db
