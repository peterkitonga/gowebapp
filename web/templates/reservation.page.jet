{{ extends "layouts/base.layout.jet" }}

{{ block title() }}Book Now{{ end }}

{{ block body() }}
<div class="container">
  <div class="row">
    <div class="col">
      <h1 class="mt-5">Make Reservation</h1>

      {{res := Data.reservation}}

      <form method="POST" action="/make-reservation" class="{{if !Form.Valid()}}needs-validation{{end}}"
        novalidate>
        <input type="hidden" name="csrf_token" value="{{ CSRFToken }}">
        <div class="row g-3">
          <div class="col mb-3">
            <label for="first-name" class="form-label">First Name</label>
            <div class="input-group has-validation" data-td-target-input="nearest" data-td-target-toggle="nearest">
              <input type="text" class="form-control{{if Form.Errors.Get("first_name")}} is-invalid{{end}}" id="first-name" name="first_name"
                value="{{res.FirstName}}" autocomplete="off">
              {{if Form.Errors.Get("first_name")}}
              <div class="invalid-feedback">
                {{Form.Errors.Get("first_name")}}
              </div>
              {{end}}
            </div>
          </div>

          <div class="col mb-3">
            <label for="last-name" class="form-label">Last Name</label>
            <div class="input-group has-validation" data-td-target-input="nearest" data-td-target-toggle="nearest">
              <input type="text" class="form-control{{if Form.Errors.Get("last_name")}} is-invalid{{end}}" id="last-name" name="last_name" value="{{res.LastName}}"
                autocomplete="off">
              {{if Form.Errors.Get("last_name")}}
              <div class="invalid-feedback">
                {{Form.Errors.Get("last_name")}}
              </div>
              {{end}}
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <div class="input-group has-validation" data-td-target-input="nearest" data-td-target-toggle="nearest">
            <input type="email" class="form-control{{if Form.Errors.Get("email")}} is-invalid{{end}}" id="email" name="email" value="{{res.Email}}"
              autocomplete="off">
            {{if Form.Errors.Get("email")}}
            <div class="invalid-feedback">
              {{Form.Errors.Get("email")}}
            </div>
            {{end}}
          </div>
        </div>

        <div class="mb-3">
          <label for="phone" class="form-label">Phone Number</label>
          <div class="input-group has-validation" data-td-target-input="nearest" data-td-target-toggle="nearest">
            <input type="text" class="form-control{{if Form.Errors.Get("phone")}} is-invalid{{end}}" id="phone" name="phone" value="{{res.Phone}}"
              autocomplete="off">
            {{if Form.Errors.Get("phone")}}
            <div class="invalid-feedback">
              {{Form.Errors.Get("phone")}}
            </div>
            {{end}}
          </div>
        </div>

        <button type="submit" class="btn btn-primary mx-auto d-block">Make Reservation</button>
      </form>
    </div>
  </div>
</div>
{{ end }}

{{ block scripts() }}
<script type="module"></script>
{{ end }}
