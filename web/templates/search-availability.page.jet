{{ extends "layouts/base.layout.jet" }}

{{ block title() }}Check Availability{{ end }}

{{ block body() }}
<div class="container">
  <div class="row">
    <div class="col">
      <h1 class="mt-5">Search for Availability</h1>

      <form method="POST" action="/search-availability" class="needs-validation" novalidate>
        <input type="hidden" name="csrf_token" value="{{ CSRFToken }}">
        <div class="row g-3">
          <div class="col mb-3">
            <label for="start-date" class="form-label">Starting Date</label>
            <div class="input-group has-validation" id="start-datepicker" data-td-target-input="nearest"
              data-td-target-toggle="nearest">
              <input required type="text" class="form-control" id="start-date" name="start" placeholder="YYYY-MM-DD"
                data-td-target="#start-datepicker" autocomplete="off" aria-describedby="start-datepicker-icon">
              <span class="input-group-text" data-td-target="#start-datepicker" data-td-toggle="datetimepicker"
                id="start-datepicker-icon">
                <i class="bi bi-calendar3"></i>
              </span>
              <div class="invalid-feedback">
                Please choose a start date.
              </div>
            </div>
          </div>

          <div class="col mb-3">
            <label for="end-date" class="form-label">Ending Date</label>
            <div class="input-group has-validation" id="end-datepicker" data-td-target-input="nearest"
              data-td-target-toggle="nearest">
              <input required type="text" class="form-control" id="end-date" name="end" placeholder="YYYY-MM-DD"
                data-td-target="#end-datepicker" autocomplete="off" aria-describedby="end-datepicker-icon">
              <span class="input-group-text" data-td-target="#end-datepicker" data-td-toggle="datetimepicker"
                id="end-datepicker-icon">
                <i class="bi bi-calendar3"></i>
              </span>
              <div class="invalid-feedback">
                Please choose an end date.
              </div>
            </div>
          </div>
        </div>

        <button type="submit" class="btn btn-primary mx-auto d-block">Search Availability</button>
      </form>
    </div>
  </div>
</div>
{{ end }}

{{ block scripts() }}
<script type="module">
  // Apply date pickers using TempusDominus
  new tempusDominus.TempusDominus(document.getElementById('start-datepicker'), DATEPICKER_OPTIONS);
  new tempusDominus.TempusDominus(document.getElementById('end-datepicker'), DATEPICKER_OPTIONS);
</script>
{{ end }}
