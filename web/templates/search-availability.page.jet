{{ extends "layouts/base.layout.jet" }}

{{ block title() }}Check Availability{{ end }}

{{ block body() }}
<div class="container">
  <div class="row">
    <div class="col">
      <h1 class="mt-5">Search for Availability</h1>

      {{res := Data.availability}}

      <form method="POST" action="/search-availability" class="{{if !Form.Valid()}}needs-validation{{end}}" novalidate>
        <input type="hidden" name="csrf_token" value="{{ CSRFToken }}">
        <div class="row g-3">
          <div class="col mb-3">
            <label for="start-date" class="form-label">Starting Date</label>
            <div class="input-group has-validation" id="start-datepicker" data-td-target-input="nearest"
              data-td-target-toggle="nearest">
              <input type="text" class="form-control{{if Form.Errors.Get("start")}} is-invalid{{end}}" id="start-date" name="start" placeholder="YYYY-MM-DD"
                data-td-target="#start-datepicker" autocomplete="off" aria-describedby="start-datepicker-icon" value="{{res.StartDate}}">
              <span class="input-group-text" data-td-target="#start-datepicker" data-td-toggle="datetimepicker"
                id="start-datepicker-icon">
                <i class="bi bi-calendar3"></i>
              </span>
              {{if Form.Errors.Get("start")}}
              <div class="invalid-feedback">
                {{Form.Errors.Get("start")}}
              </div>
              {{end}}
            </div>
          </div>

          <div class="col mb-3">
            <label for="end-date" class="form-label">Ending Date</label>
            <div class="input-group has-validation" id="end-datepicker" data-td-target-input="nearest"
              data-td-target-toggle="nearest">
              <input type="text" class="form-control{{if Form.Errors.Get("end")}} is-invalid{{end}}" id="end-date" name="end" placeholder="YYYY-MM-DD"
                data-td-target="#end-datepicker" autocomplete="off" aria-describedby="end-datepicker-icon" value="{{res.EndDate}}">
              <span class="input-group-text" data-td-target="#end-datepicker" data-td-toggle="datetimepicker"
                id="end-datepicker-icon">
                <i class="bi bi-calendar3"></i>
              </span>
              {{if Form.Errors.Get("end")}}
              <div class="invalid-feedback">
                {{Form.Errors.Get("end")}}
              </div>
              {{end}}
            </div>
          </div>
        </div>

        <button type="submit" class="btn btn-primary mx-auto d-block">Search Availability</button>
      </form>
    </div>
  </div>
</div>
{{ end }}

{{ block scripts() }}
<script type="module">
  // Apply date pickers using TempusDominus
  new tempusDominus.TempusDominus(document.getElementById('start-datepicker'), DATEPICKER_OPTIONS);
  new tempusDominus.TempusDominus(document.getElementById('end-datepicker'), DATEPICKER_OPTIONS);
</script>
{{ end }}
