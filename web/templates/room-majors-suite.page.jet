{{ extends "layouts/base.layout.jet" }}

{{ block title() }}Major's Suite{{ end }}

{{ block body() }}
<div class="container">
  <div class="row mt-4">
    <div class="col">
      <img src="/static/images/majors-suite.png" alt="Room: Majors Suite"
        class="rounded img-fluid room-image mx-auto d-block" />
    </div>
  </div>
  <div class="row">
    <div class="col">
      <h1 class="text-center mt-4">Major's Suite</h1>
      <p>
        Your home away form home, set on the majestic waters of the Atlantic Ocean, this will be a vacation to remember.
        Your home away form home, set on the majestic waters of the Atlantic Ocean, this will be a vacation to remember.
        Your home away form home, set on the majestic waters of the Atlantic Ocean, this will be a vacation to remember.
        Your home away form home, set on the majestic waters of the Atlantic Ocean, this will be a vacation to remember.
        Your home away form home, set on the majestic waters of the Atlantic Ocean, this will be a vacation to remember.
        Your home away form home, set on the majestic waters of the Atlantic Ocean, this will be a vacation to remember.
      </p>
    </div>
  </div>

  <div class="row">
    <div class="col text-center">
      <button type="button" class="btn btn-outline-success" data-bs-toggle="modal"
        data-bs-target="#check-availability-modal"><i class="bi bi-arrow-up-square-fill"></i> Check Availability</button>
      <div id="check-availability-modal" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Search Availability</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <form method="POST" action="/search-availability" id="check-availability-form" class="needs-validation" novalidate>
                <input type="hidden" name="csrf_token" value="{{ CSRFToken }}">
                <div class="row g-3">
                  <div class="col-md-12 col-lg-6 mb-3">
                    <label for="start-date" class="form-label">Starting Date</label>
                    <div class="input-group has-validation" id="start-datepicker" data-td-target-input="nearest"
                      data-td-target-toggle="nearest">
                      <input required type="text" class="form-control" id="start-date" name="start"
                        placeholder="YYYY-MM-DD" data-td-target="#start-datepicker" autocomplete="off"
                        aria-describedby="start-datepicker-icon">
                      <span class="input-group-text" data-td-target="#start-datepicker" data-td-toggle="datetimepicker"
                        id="start-datepicker-icon">
                        <i class="bi bi-calendar3"></i>
                      </span>
                      <div class="invalid-feedback">
                        Please choose a start date.
                      </div>
                    </div>
                  </div>

                  <div class="col-md-12 col-lg-6 mb-3">
                    <label for="end-date" class="form-label">Ending Date</label>
                    <div class="input-group has-validation" id="end-datepicker" data-td-target-input="nearest"
                      data-td-target-toggle="nearest">
                      <input required type="text" class="form-control" id="end-date" name="end"
                        placeholder="YYYY-MM-DD" data-td-target="#end-datepicker" autocomplete="off"
                        aria-describedby="end-datepicker-icon">
                      <span class="input-group-text" data-td-target="#end-datepicker" data-td-toggle="datetimepicker"
                        id="end-datepicker-icon">
                        <i class="bi bi-calendar3"></i>
                      </span>
                      <div class="invalid-feedback">
                        Please choose an end date.
                      </div>
                    </div>
                  </div>
                </div>
              </form>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button type="button" class="btn btn-primary" id="check-availability-modal-confirm">Search
                Availability</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ end }}


{{ block scripts() }}
<script type="module">
  // Apply date pickers using TempusDominus
  new tempusDominus.TempusDominus(document.getElementById('start-datepicker'), DATEPICKER_OPTIONS);
  new tempusDominus.TempusDominus(document.getElementById('end-datepicker'), DATEPICKER_OPTIONS);

  document.getElementById('check-availability-modal-confirm').addEventListener('click', () => {
    const formElement = document.getElementById('check-availability-form');
    const modalElement = document.getElementById('check-availability-modal');
    const modalInstance = bootstrap.Modal.getOrCreateInstance(modalElement);
    const startDate = document.getElementById('start-date');
    const endDate = document.getElementById('end-date');

    if (startDate.value.length === 0 || endDate.value.length === 0) {
      toggleToast(`Please select all fields before submitting`, 'error');
    } else {
      modalInstance.hide();

      formElement.submit();
    }
  });
</script>
{{ end }}
